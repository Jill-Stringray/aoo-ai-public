<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.clockshore.aooai.mapper.DocumentChunkMapper">

    <resultMap id="DocumentChunkMap"
               type="com.clockshore.aooai.entity.DocumentChunk">

        <id property="id" column="id"/>

        <result property="knowledgeBaseId"
                column="knowledge_base_id"/>

        <result property="documentId"
                column="document_id"/>

        <result property="chunkKey"
                column="chunk_key"/>

        <result property="chunkIndex"
                column="chunk_index"/>

        <result property="content"
                column="content"/>

        <result property="contentHash"
                column="content_hash"/>

        <result property="tokenCount"
                column="token_count"/>

        <result property="pageNo"
                column="page_no"/>

        <result property="sectionTitle"
                column="section_title"/>

        <result property="metadata"
                column="metadata"/>

        <result property="vectorRef"
                column="vector_ref"/>

        <result property="status"
                column="status"/>

        <result property="createdAt"
                column="created_at"/>

        <result property="updatedAt"
                column="updated_at"/>

    </resultMap>

    <insert id="insert"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO document_chunk(
            knowledge_base_id,
            document_id,
            chunk_key,
            chunk_index,
            content,
            content_hash,
            token_count,
            page_no,
            section_title,
            metadata,
            vector_ref,
            status
        )
        VALUES(
                  #{knowledgeBaseId},
                  #{documentId},
                  #{chunkKey},
                  #{chunkIndex},
                  #{content},
                  #{contentHash},
                  #{tokenCount},
                  #{pageNo},
                  #{sectionTitle},
                  #{metadata},
                  #{vectorRef},
                  #{status}
              )

    </insert>

    <select id="selectById"
            resultMap="DocumentChunkMap">

        SELECT *
        FROM document_chunk
        WHERE id = #{id}

    </select>

    <select id="selectByDocumentId"
            resultMap="DocumentChunkMap">

        SELECT *
        FROM document_chunk
        WHERE document_id = #{documentId}
        ORDER BY chunk_index

    </select>

    <update id="updateStatus">

        UPDATE document_chunk
        SET status = #{status}
        WHERE id = #{id}

    </update>

    <update id="updateVectorRef">

        UPDATE document_chunk
        SET vector_ref = #{vectorRef}
        WHERE id = #{id}

    </update>

    <delete id="deleteByDocumentId">

        DELETE
        FROM document_chunk
        WHERE document_id = #{documentId}

    </delete>

</mapper>