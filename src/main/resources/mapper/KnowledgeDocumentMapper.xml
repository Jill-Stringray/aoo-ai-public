<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.clockshore.aooai.mapper.KnowledgeDocumentMapper">

    <resultMap id="KnowledgeDocumentMap"
               type="com.clockshore.aooai.entity.KnowledgeDocument">

        <id property="id" column="id"/>

        <result property="knowledgeBaseId" column="knowledge_base_id"/>
        <result property="documentKey" column="document_key"/>
        <result property="title" column="title"/>
        <result property="fileName" column="file_name"/>
        <result property="fileType" column="file_type"/>
        <result property="mimeType" column="mime_type"/>
        <result property="fileSize" column="file_size"/>
        <result property="storageUrl" column="storage_url"/>
        <result property="sourceType" column="source_type"/>
        <result property="sourceUrl" column="source_url"/>
        <result property="versionNo" column="version_no"/>
        <result property="status" column="status"/>
        <result property="checksum" column="checksum"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

    </resultMap>

    <insert id="insert"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO knowledge_document(
            knowledge_base_id,
            document_key,
            title,
            file_name,
            file_type,
            mime_type,
            file_size,
            storage_url,
            source_type,
            status,
            checksum,
            created_by
        )
        VALUES(
                  #{knowledgeBaseId},
                  #{documentKey},
                  #{title},
                  #{fileName},
                  #{fileType},
                  #{mimeType},
                  #{fileSize},
                  #{storageUrl},
                  #{sourceType},
                  #{status},
                  #{checksum},
                  #{createdBy}
              )

    </insert>

    <select id="selectById"
            resultMap="KnowledgeDocumentMap">

        SELECT *
        FROM knowledge_document
        WHERE id = #{id}

    </select>

    <update id="updateStatus">

        UPDATE knowledge_document
        SET status = #{status}
        WHERE id = #{id}

    </update>

    <delete id="deleteById">

        DELETE
        FROM knowledge_document
        WHERE id = #{id}

    </delete>

</mapper>