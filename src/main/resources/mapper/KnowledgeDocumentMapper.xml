<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.clockshore.aooai.mapper.KnowledgeDocumentMapper">

    <insert id="insert"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO knowledge_document(
            knowledge_base_id,
            document_key,
            title,
            file_name,
            file_type,
            mime_type,
            file_size,
            storage_url,
            source_type,
            status,
            checksum,
            created_by
        )
        VALUES(
                  #{knowledgeBaseId},
                  #{documentKey},
                  #{title},
                  #{fileName},
                  #{fileType},
                  #{mimeType},
                  #{fileSize},
                  #{storageUrl},
                  #{sourceType},
                  #{status},
                  #{checksum},
                  #{createdBy}
              )

    </insert>

    <select id="selectById"
            resultType= "com.clockshore.aooai.entity.KnowledgeDocument">

        SELECT *
        FROM knowledge_document
        WHERE id = #{id}

    </select>

    <update id="updateStatus">

        UPDATE knowledge_document
        SET status = #{status}
        WHERE id = #{id}

    </update>

    <delete id="deleteById">

        DELETE
        FROM knowledge_document
        WHERE id = #{id}

    </delete>

</mapper>